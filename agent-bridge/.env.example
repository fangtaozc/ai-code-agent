# agent-bridge 配置文件
# 复制此文件为 .env，然后填入你的 API Key。
# 注意：.env 文件不会被提交到 Git，请妥善保管。

# ── Claude（Anthropic）──────────────────────────────────────────────────────
# 使用 Claude 时必填。API Key 在 https://console.anthropic.com/api-keys 获取。
ANTHROPIC_API_KEY=sk-ant-...

# 使用官方 API 时留空。如果你通过代理或内部接口访问，填入代理地址。
# 示例：ANTHROPIC_BASE_URL=http://your-proxy.example.com
ANTHROPIC_BASE_URL=

# ── Codex（OpenAI / Azure）─────────────────────────────────────────────────
# 使用 Codex 时必填。API Key 在 https://platform.openai.com/api-keys 获取。
OPENAI_API_KEY=sk-...

# 使用官方 OpenAI API 时留空。如果你使用 Azure OpenAI，填入 Azure 的接口地址。
# 示例：OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/v1
OPENAI_BASE_URL=

# ── Relay 地址 ───────────────────────────────────────────────────────────────
# 本地使用时保持默认，不需要修改。
# 如果 cloud-relay 部署在远程服务器，改为：ws://服务器IP:3000/ws/bridge
RELAY_URL=ws://localhost:3000/ws/bridge
